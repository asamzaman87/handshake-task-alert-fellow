{
  "manifest_version": 3,
  "name": "ivy project",
  "version": "1.0.0",
  "description": "Triggers remote Handshake polls and phone alerts through your deployed backend.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ivy project"
  }
}
