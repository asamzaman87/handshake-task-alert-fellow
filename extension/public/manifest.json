{
  "manifest_version": 3,
  "name": "ivy project",
  "version": "1.0.0",
  "description": "Polls Handshake task availability and triggers phone alerts through a backend service.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://handshake-task-alert-fellow.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handshake Alerts"
  }
}
